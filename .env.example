# Copy to .env.local for local testing, or set in Vercel Dashboard
# Required
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=5188494297
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Required for reliable pricing (get free key at alphavantage.co)
ALPHA_VANTAGE_API_KEY=your_alphavantage_key

# Optional: Backup price source (get free key at twelvedata.com)
TWELVE_DATA_API_KEY=your_twelvedata_key

# Optional: Secure cron endpoint
CRON_SECRET=generate_a_random_string_here

# Optional: NVIDIA Nemotron API for news summarization (get at nvidia.com/ai)
NVIDIA_API_KEY=your_nvidia_api_key